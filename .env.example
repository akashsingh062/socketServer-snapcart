# ==============================================================================
# SnapCart Socket.io Microservice Environment Variables
# ==============================================================================
# Duplicate this file as `.env` and configure accordingly.
# ==============================================================================

# Port the Socket.io server listens on (Default: 4000)
PORT=4000

# Next.js Application URL (for CORS allowance and HTTP backend synchronization)
NEXT_BASE_URL="http://localhost:3000"
